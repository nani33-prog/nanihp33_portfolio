# Copy this file to .env and fill in values for local or production use.
# Never commit a real .env file.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL empty locally to use SQLite.
# On Render, add a PostgreSQL database and this will be set automatically.
# DATABASE_URL=

# Optional extra CSRF origins (comma-separated), e.g. https://your-app.onrender.com
# CSRF_TRUSTED_ORIGINS=
